# Bytecode / cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Ambienti virtuali
.venv/
venv/
env/

# Packaging / build
build/
dist/
*.egg-info/

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Artefatti di runtime del gioco (save in chiaro + sidecar compressi + temp atomici +
# backup di recovery): sono stato di gioco locale, MAI da versionare. I test scrivono
# in tmp, ma questa è la rete di sicurezza contro un save che finisce nel repo.
*.stato.json
*.archivio.gz
*.bak.stato.json
*.bak.archivio.gz
*.tmp

# Crawler salvati da un host (slot = crawler, H §1): stato di gioco locale.
salvataggi/

# Asset creati a runtime dall'authoring (stato di guscio persistente, H §12):
# contenuto locale dell'installazione. Gli UFFICIALI in contenuti/ sono versionati.
contenuti_locali/

# Override di calibrazione (§11) scritti dalla console admin (`calibratore`): numeri locali
# in fase di taratura, MAI da versionare. I default vivono in `motore/calibrazione.py`.
calibrazione.overrides.json

# Segreti locali (PLK §4): la chiave API vive SOLO nell'ambiente o in un .env locale,
# MAI nel repo. Committare solo .env.example (template senza valori).
.env
.env.*
!.env.example

# La SPA vive SOLO sul branch laboratorio (`react-ecosystem`). Se `web/` compare qui è
# un residuo su disco di uno switch di branch (node_modules non è tracciato da nessuna
# parte): su questo branch non va committato MAI — è il branch del solo motore.
web/

# esper VENDORIZZATO è versionato di proposito: NON ignorarlo.
!vendor/
docs/

# Raccolto generativo di misura_run (--json / --json-oggetti): output generato,
# fotografia locale — mai versionato.
raccolto*.json
